# ===== Python AI 服务密钥 (必填 4 个核心) =====
# 火山方舟 doubao (答疑 decide/generate + RAG intent/rewrite/生成)
DOUBAO_API_KEY=
# 阿里 DashScope (embedding, 向量索引查询)
DASHSCOPE_API_KEY=
# 腾讯云 COS 向量桶凭据 (题型/答疑 RAG 向量 + RAG 原文读取)
COS_VECTORS_SECRET_ID=
COS_VECTORS_SECRET_KEY=
COS_VECTORS_REGION=ap-guangzhou
# 题型聚集(topic)桶; 如不确定留空, RAG 用 rag 桶
COS_VECTORS_BUCKET=
# RAG 向量独立桶(已存在, 一般不动)
COS_VECTORS_RAG_BUCKET=rag-1318177119
# 内部调用令牌(必须与 Java application.yml 的 llm.gateway.internal-token 一致)
INTERNAL_TOKEN=my-secret-token-123

# ===== 可选(按需) =====
# ZHIPU_API_KEY=
# DEEPSEEK_API_KEY=
# BAILIAN_API_KEY=
# BAIDU_OCR_API_KEY=
